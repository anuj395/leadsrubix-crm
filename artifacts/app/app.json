{
  "expo": {
    "name": "Leads Rubix CRM",
    "slug": "leads-rubix",
    "version": "1.0.1",
    "scheme": "leadsrubixcrm",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/emblem_hero.png",
      "resizeMode": "contain",
      "backgroundColor": "#151728"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leadsrubix.crm",
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/emblem_hero.png",
        "resizeMode": "contain",
        "backgroundColor": "#151728",
        "dark": {
          "image": "./assets/emblem_hero.png",
          "backgroundColor": "#151728"
        }
      },
      "infoPlist": {
        "CFBundleDisplayName": "Leads Rubix CRM",
        "NSCameraUsageDescription": "Leads Rubix uses the camera for uploading deal documents and lead attachments.",
        "NSPhotoLibraryUsageDescription": "Leads Rubix uses the photo library for uploading lead attachments.",
        "NSMicrophoneUsageDescription": "Leads Rubix uses the microphone for recording call logs and voice notes.",
        "NSContactsUsageDescription": "Leads Rubix requires access to contacts to allow users to select and attach contact details while creating a lead.",
        "NSLocationWhenInUseUsageDescription": "Leads Rubix uses your location to capture accurate site visit check-ins and lead coordinates.",
        "NSCalendarsUsageDescription": "Leads Rubix requires calendar access to synchronize scheduled client visits and tasks.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151728",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.leadsrubix.crm",
      "versionCode": 10,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#EA580C"
        }
      ]
    ],
    "androidNavigationBar": {
      "visible": "always",
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "749b72c8-bc02-4d8a-90cd-507490ebbfdf"
      }
    }
  }
}